DATABASE_URL=postgresql://mindmitra:change-me@localhost:5432/mindmitra
# Match the browser address, including its port (and Google OAuth redirect URI).
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Install matching Tesseract language packs. For Hindi scans use eng+hin.
PDF_OCR_LANGUAGES=eng

# Optional absolute paths for custom Windows/server media installations:
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe

# PDF tools are automatically detected in standard Windows installation folders.
# Override only for custom locations; use executable paths, not folders:
# TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe
# PDFINFO_PATH=C:/poppler/Library/bin/pdfinfo.exe
# PDFTOTEXT_PATH=C:/poppler/Library/bin/pdftotext.exe
# PDFTOPPM_PATH=C:/poppler/Library/bin/pdftoppm.exe
# Or set POPPLER_PATH to the folder containing the three Poppler executables.
